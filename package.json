{
  "name": "voyvoweb",
  "version": "2.0.0",
  "description": "Web + CMS de la Pizzería Voy Volando — Santa Fe, Granada",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/api.test.js tests/build-static.test.js tests/orders.test.js tests/theme.test.js",
    "lint": "eslint src scripts tests public/js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" \"*.json\" \"docs/**/*.md\"",
    "check": "eslint src scripts tests public/js && prettier --check \"src/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\" && node --test tests/api.test.js tests/build-static.test.js tests/orders.test.js tests/theme.test.js",
    "backup": "node scripts/backup.mjs",
    "build:static": "node scripts/build-static.mjs",
    "theme:sync": "node scripts/sync-theme.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4"
  }
}
