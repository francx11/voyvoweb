{
  "name": "voyvoweb",
  "version": "2.0.0",
  "description": "Web + CMS de la Pizzería Voy Volando — Santa Fe, Granada",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src scripts",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.mjs\" \"*.json\" \"docs/**/*.md\"",
    "check": "eslint src scripts && prettier --check \"src/**/*.js\" \"scripts/**/*.mjs\" && node --check src/server.js",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4"
  }
}
