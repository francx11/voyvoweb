# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# production activa cookies Secure (requiere HTTPS)
NODE_ENV=development

# Contraseña inicial del admin (solo se usa si data/auth.json no existe).
# Alternativa legado: ADMIN_PASSWORD_HASH con un sha256 hex.
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# API key de Google Places: reseñas (el Place ID se configura desde el panel)
# y autocompletado de dirección en el checkout de domicilio. Sin ella, ambas
# funciones se desactivan solas (sin error) — no es obligatoria.
GOOGLE_API_KEY=

# Pedidos online (carrito, checkout, panel de Pedidos, Stripe). Desactivados
# por defecto: sin ORDERING_ENABLED=true no se montan /api/orders, /api/places
# ni el webhook de Stripe, y la web se sirve sin carrito. Manda sobre el
# interruptor "Pedidos online activados" del panel.
ORDERING_ENABLED=false

# Dominio del export estático (scripts/build-static.mjs → dist/CNAME)
SITE_DOMAIN=voyvolandosantafe.com

# Analítica del build estático. GTM ya va por defecto en src/config.js y GA4 se
# gestiona dentro de ese contenedor. GA_MEASUREMENT_ID cargaría GA4 aparte:
# no lo pongas mientras GTM lleve la etiqueta de GA4, o se cuenta doble.
# Nada se carga hasta que el visitante acepta las cookies (public/js/consent.js).
# GTM_CONTAINER_ID=GTM-T3G79KW8
# GA_MEASUREMENT_ID=

# Pon NOINDEX=true en el despliegue que solo sirve el panel (gestion.*): manda
# cabecera X-Robots-Tag: noindex y un robots.txt con Disallow: /. Así el panel
# deja de competir en Google con el sitio público. En local, déjalo sin poner.

# Stripe (pedidos online). sk_test_/sk_live_ determina el modo mostrado en el panel.
# Sin estas claves el pago con tarjeta se desactiva solo; el contra-reembolso sigue funcionando.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL pública del sitio, usada en las redirecciones de Stripe Checkout
PUBLIC_BASE_URL=http://localhost:3000

# SMTP (email de cancelación de pedido). Sin estas claves las notificaciones
# se desactivan solas — igual que Stripe/Google, no rompe nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
