# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# production activa cookies Secure (requiere HTTPS)
NODE_ENV=development

# Contraseña inicial del admin (solo se usa si data/auth.json no existe).
# Alternativa legado: ADMIN_PASSWORD_HASH con un sha256 hex.
ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=

# API key de Google Places para las reseñas (el Place ID se configura desde el panel)
GOOGLE_API_KEY=
